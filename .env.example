# ─── 判断层（AI）───
# stub = 本地模板（不花钱，可离线）；openai = 任意 OpenAI 兼容网关
JUDGE_PROVIDER=stub
JUDGE_API_KEY=sk-fake-key-replace-me
JUDGE_MODEL=gpt-4o-mini
JUDGE_BASE_URL=https://api.openai.com/v1

# ─── 管线配置 ───
PIPELINE_DAILY_RUN_TIME=21:00
PIPELINE_LOOKBACK_DAYS=1

# ─── 采集 / 渲染 ───
COLLECT_MATERIALS_DIR=./materials
# 自动素材夹：快捷指令写入的文件夹，多个用逗号分隔；留空则只收手动投递
# 例：~/Library/Mobile Documents/com~apple~CloudDocs/StepLedgerInbox
COLLECT_SOURCE_DIRS=
RENDER_CHANNELS=console
RENDER_ARCHIVE_DIR=./archive

# ─── 桌宠渠道（可选，需装 dsh-pet）───
# 把 RENDER_CHANNELS 改成 console,pet 才启用；地址只接受本机，端口按 DSH 实际监听的填
PET_BASE_URL=
# 例：PET_BASE_URL=http://127.0.0.1:3000/dsh-pet-7340
PET_ID=main
# 空 = 内置五档；off = 只弹气泡不播动画；否则填 5 个动画名（低→高）
PET_ANIM_TIERS=

# ─── 每日插画（可选，需 Agent Plan / 生图服务）───
# 不配 key 就整段跳过：播报只播文字，零网络、零新文件
ILLUSTRATION_ENABLED=auto
ILLUSTRATION_API_KEY=
ILLUSTRATION_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ILLUSTRATION_MODEL=doubao-seedream-5.0-flash
ILLUSTRATION_SIZE=2K
ILLUSTRATION_QUALITY=medium
# 旧版 dsh-pet 没有 /character 时的本地参考图（不进仓库）
ILLUSTRATION_REFERENCE=
# 覆盖默认角色卡（视觉设定，不是 whisperPrompt）
ILLUSTRATION_CHARACTER=
# 覆盖素材根；空 = 从 /config 按 PET_ID 找
PET_CHARACTER_ROOT=
